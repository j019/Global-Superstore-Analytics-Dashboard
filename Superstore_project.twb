      </column>
      <column caption='Total Shipping Cost' datatype='real' default-format='c&quot;$&quot;#,##0,K;(&quot;$&quot;#,##0,K)' name='[Calculation_1269943713251330]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Shipping Cost])' />
      </column>
      <column caption='Total Quantity' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_1269943713374211]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Quantity])' />
      </column>
      <column caption='Avg Discount' datatype='real' default-format='p0.0%' name='[Calculation_1269943713509380]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Discount])' />
      </column>
      <column caption='No. of Orders' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_1269943713714181]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Order ID])' />
      </column>
      <column caption='No. of Customers' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_1269943714308102]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Customer ID])' />
      </column>
      <column caption='No. of Products' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_1269943714410503]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Product ID])' />
      </column>
      <column caption='No. of Return Orders' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_1269943714492424]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Order ID (Returned Orders)])' />
      </column>
      <column caption='Profit Ratio' datatype='real' default-format='p0.0%' name='[Calculation_1269943714758665]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1269943712976897] / [Calculation_1269943711903744]' />
      </column>
      <column caption='Discount Amount' datatype='real' name='[Calculation_1269943719723018]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Actual Revenue] * [Discount]' />
      </column>
      <column caption='Profit Status' datatype='string' name='[Calculation_1269943721132043]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Actual Profit] &lt; 0 THEN &quot;Loss&quot;&#13;&#10;ELSEIF [Actual Profit] &gt; 0 THEN &quot;Profit&quot;&#13;&#10;ELSE &quot;No Loss No Profit&quot;&#13;&#10;END' />
      </column>
      <column caption='No. of Losses' datatype='integer' name='[Calculation_1269943722881036]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT( &#13;&#10;if [Calculation_1269943721132043] = &quot;Loss&quot; THEN&#13;&#10;[Calculation_1269943721132043]&#13;&#10;END&#13;&#10;)' />
      </column>
      <column caption='Delay Days' datatype='integer' name='[Calculation_1269943724351501]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, &#13;&#10;[Expected Ship Date], &#13;&#10;[Actual Ship Date])' />
      </column>
      <column caption='No. of Delayed Orders' datatype='integer' name='[Calculation_1269943725596686]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD( &#13;&#10;if [Calculation_1269943724351501] &gt; 0 THEN&#13;&#10;[Order ID]&#13;&#10;END&#13;&#10;)' />
      </column>
      <column caption='Avg Delay Days' datatype='real' default-format='n#,##0&quot; days&quot;;-#,##0&quot; days&quot;' name='[Calculation_1269943726985231]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ROUND(AVG([Calculation_1269943724351501]),0)' />
      </column>
      <column caption='Profit Ratio Category' datatype='string' name='[Calculation_1269943731990544]' role='measure' type='nominal'>
        <calculation class='tableau' formula='CASE True&#13;&#10;    WHEN [Calculation_1269943714758665] &gt;=0.25 THEN &quot;C1&quot;&#13;&#10;    WHEN [Calculation_1269943714758665] &gt;=0.17 AND [Calculation_1269943714758665] &lt;= 0.24 THEN &quot;C2&quot;&#13;&#10;    WHEN [Calculation_1269943714758665] &gt;=0.11 AND [Calculation_1269943714758665] &lt;=0.16 THEN &quot;C3&quot;&#13;&#10;    ELSE &quot;C4&quot;&#13;&#10;END' />
      </column>
      <column caption='Annual Profit 2019' datatype='real' name='[Calculation_1269943744323601]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM( IF YEAR([Order Date]) == 2019&#13;&#10;THEN[Actual Profit]&#13;&#10;END&#13;&#10;)' />
      </column>
      <column caption='Annual Profit 2020' datatype='real' name='[Calculation_1269943744696338]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM( IF YEAR([Order Date]) == 2020&#13;&#10;THEN[Actual Profit]&#13;&#10;END&#13;&#10;)' />
      </column>
      <column caption='Annual Profit 2021' datatype='real' name='[Calculation_1269943744888851]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM( IF YEAR([Order Date]) == 2021&#13;&#10;THEN[Actual Profit]&#13;&#10;END&#13;&#10;)' />
      </column>
      <column caption='Annual Profit 2022' datatype='real' name='[Calculation_1269943745007636]' role='measure' type='quantitative'>
