            <column caption='Delay Days' datatype='integer' name='[Calculation_1269943724351501]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, &#13;&#10;[Expected Ship Date], &#13;&#10;[Actual Ship Date])' />
            </column>
            <column caption='Avg Delay Days' datatype='real' default-format='n#,##0&quot; days&quot;;-#,##0&quot; days&quot;' name='[Calculation_1269943726985231]' role='measure' type='quantitative'>
