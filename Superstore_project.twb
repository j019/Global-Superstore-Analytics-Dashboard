            <column caption='Annual Profit 2019' datatype='real' name='[Calculation_1269943744323601]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM( IF YEAR([Order Date]) == 2019&#13;&#10;THEN[Actual Profit]&#13;&#10;END&#13;&#10;)' />
