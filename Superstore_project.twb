      <column caption='Total Revenue' datatype='real' default-format='c&quot;$&quot;#,##0,K;(&quot;$&quot;#,##0,K)' name='[Calculation_1269943711903744]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Actual Revenue])' />
      </column>
      <column caption='Total Profit' datatype='real' default-format='c&quot;$&quot;#,##0,K;(&quot;$&quot;#,##0,K)' name='[Calculation_1269943712976897]' role='measure' type='quantitative'>
