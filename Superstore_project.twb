  <actions>
    <action caption='Filter Quantity By Segment &amp; Order Priority' name='[Action1_14E6507CD38C4BCF9CA4E3B921C58699]'>
      <activation auto-clear='true' type='on-select' />
      <source dashboard='Monthly Quantity Analysis by Segment &amp; Order Priority Dashboard' type='sheet'>
        <exclude-sheet name='Monthly Total Quantity ' />
      </source>
      <command command='tsc:tsl-filter'>
        <param name='exclude' value='Profit % by Order Priority,Profit % by segment' />
        <param name='special-fields' value='all' />
        <param name='target' value='Monthly Quantity Analysis by Segment &amp; Order Priority Dashboard' />
      </command>
    </action>
    <action caption='Filter losses by Market' name='[Action2_58A57259AA0E4610898043C3E795E9AC]'>
      <activation auto-clear='true' type='on-select' />
      <source dashboard='Monthly Loss Analysis by Market Dashboard' type='sheet' worksheet='Average Delay Delays By Market' />
      <command command='tsc:tsl-filter'>
        <param name='exclude' value='Average Delay Delays By Market' />
        <param name='special-fields' value='all' />
        <param name='target' value='Monthly Loss Analysis by Market Dashboard' />
      </command>
    </action>
    <action caption='Filter Discount By Region' name='[Action3_5ABD0F3584364371A6B8AC84D6F946F4]'>
      <activation auto-clear='true' type='on-select' />
      <source dashboard='Average Discount Analysis By Region DashBoard' type='sheet' worksheet='Profit Ratio By Region' />
      <command command='tsc:tsl-filter'>
        <param name='exclude' value='Profit Ratio By Region' />
        <param name='special-fields' value='all' />
        <param name='target' value='Average Discount Analysis By Region DashBoard' />
      </command>
    </action>
    <action caption='Filter KPIs By Sub-Category' name='[Action4_CBCF6C6004E149BEA184C0146400E839]'>
      <activation auto-clear='true' type='on-hover' />
      <source dashboard='KPI Analysis by Sub-category Dashboard' type='sheet' worksheet='Total revenue by Sub-category' />
      <command command='tsc:tsl-filter'>
        <param name='exclude' value='Total revenue by Sub-category' />
        <param name='special-fields' value='all' />
        <param name='target' value='KPI Analysis by Sub-category Dashboard' />
      </command>
    </action>
    <action caption='Filter KPI By Country' name='[Action5_5FF013B01CBA4CC0AAC623EF6675A310]'>
      <activation auto-clear='true' type='on-select' />
      <source dashboard='KPI Analysis by Country Dashboard' type='sheet' worksheet='Country Master' />
      <command command='tsc:tsl-filter'>
        <param name='exclude' value='Country Master' />
        <param name='special-fields' value='all' />
        <param name='target' value='KPI Analysis by Country Dashboard' />
      </command>
    </action>
    <action caption='Filter profit &amp; Discount By Manager' name='[Action6_E1EED0AAA302457F8B2F276FFB0A8F92]'>
      <activation auto-clear='true' type='on-select' />
      <source dashboard='Analysis By Manager DashBoard' type='sheet'>
        <exclude-sheet name='Avg Discount By Sub-Category(TreeMap)' />
        <exclude-sheet name='Profit % by Category' />
        <exclude-sheet name='Profit % by Order Priority' />
      </source>
      <command command='tsc:tsl-filter'>
        <param name='exclude' value='Manager Master' />
        <param name='special-fields' value='all' />
        <param name='target' value='Analysis By Manager DashBoard' />
      </command>
    </action>
    <action caption='Show Country Wikipedia Page' name='[Action7_66880ACBD9DB4CDF851DF341DD5B8A17]'>
      <activation type='on-select' />
      <source dashboard='Country Information DashBoard' type='sheet' worksheet='Country Master' />
      <link caption='' expression='https://en.wikipedia.org/wiki/&lt;[Country]&gt;' />
    </action>
    <action caption='Highlight 1 (generated)' name='[Action8_EA066C6EEA9F4707AE94EA3B613C519E]'>
      <activation auto-clear='true' type='on-select' />
      <source dashboard='Category Analysis' type='sheet' />
      <command command='tsc:brush'>
        <param name='field-captions' value='Category' />
        <param name='target' value='Category Analysis' />
      </command>
    </action>
    <datasources>
      <datasource caption='Orders+ (Global Superstore)' name='federated.15cugad0kraitg1h92kg11mp2kmj' />
